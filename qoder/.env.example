# 复制为 .env 后按需修改。.env 不会被提交（见 .gitignore）。
# 这些值只被后端读取；token 绝不发给浏览器，也不会写入日志/证据。

# 被代理的 PowerContext Server 地址（本赛题本地 SQLite 模式默认端口示例）
POWERCONTEXT_URL=http://127.0.0.1:8777

# 若你的 PowerContext 开启了 Bearer 鉴权，在这里填 token；本地演示可留空。
POWERCONTEXT_TOKEN=

# 研究续航站 Web 后端监听地址与端口（仅本地）
APP_HOST=127.0.0.1
APP_PORT=8688
